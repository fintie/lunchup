LUNCHUP_API_URL=https://lunchup.onrender.com/api
LUNCHUP_INGEST_KEY=replace-with-the-same-value-used-by-lunchup

# Only these exact group names are monitored.
WECHAT_ROOM_WHITELIST=LunchUp Founders,LunchUp Sydney
HIGHLIGHT_MARKER=#亮点

# Set true to omit the WeChat display name from LunchUp.
ANONYMISE_AUTHORS=false
DRY_RUN=true

# Replace with a licensed Puppet provider for production use.
WECHATY_PUPPET=wechaty-puppet-wechat4u
WECHATY_PUPPET_TOKEN=
WECHATY_BOT_NAME=lunchup-highlight-bot
