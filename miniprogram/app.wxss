page {
  background: #f7f7f5;
  color: #242220;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.hero {
  padding: 40rpx 34rpx;
  border-radius: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #f28a45, #dd542c);
  box-shadow: 0 18rpx 50rpx rgba(218, 84, 39, 0.2);
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-copy {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.65;
}

.section {
  margin-top: 34rpx;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 34rpx;
  font-weight: 750;
}

.card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #eee7df;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(62, 47, 36, 0.05);
}

.card-title {
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
}

.muted {
  color: #817a74;
  line-height: 1.55;
}

.meta {
  margin-top: 12rpx;
  color: #9a918a;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  margin: 12rpx 12rpx 0 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #b24b22;
  background: #fff0e6;
  font-size: 23rpx;
}

.button-primary,
.button-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  margin-top: 20rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.button-primary {
  color: #fff;
  background: #e86f2d;
}

.button-secondary {
  color: #a84720;
  background: #fff0e6;
}

button::after {
  border: 0;
}

.input,
.textarea,
.picker {
  width: 100%;
  margin-top: 12rpx;
  padding: 22rpx;
  border: 1rpx solid #e5ddd5;
  border-radius: 18rpx;
  background: #fff;
  box-sizing: border-box;
}

.textarea {
  min-height: 150rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-weight: 650;
}

.state {
  padding: 80rpx 30rpx;
  color: #8c847e;
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #f1ece7;
}

.grow {
  flex: 1;
  min-width: 0;
}
