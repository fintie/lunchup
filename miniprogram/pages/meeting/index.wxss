.heading {
  margin: 12rpx 0 26rpx;
}

.small-button {
  width: 170rpx;
  margin: 0;
  color: #fff;
  background: #e86f2d;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.notice {
  margin: 18rpx 0;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #a84720;
  background: #fff0e6;
}

.meeting-time {
  margin: 18rpx 0 8rpx;
  font-weight: 700;
}

.status {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #9a5b1c;
  background: #fff2d8;
  font-size: 21rpx;
}

.status-confirmed,
.status-completed {
  color: #247653;
  background: #dff5e9;
}

.status-cancelled {
  color: #a83b35;
  background: #fde6e3;
}

.status-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.mini-action {
  flex: 1;
  margin: 0;
  color: #a84720;
  background: #fff0e6;
  border-radius: 14rpx;
  font-size: 23rpx;
}

.mini-action.danger {
  color: #a83b35;
  background: #fde6e3;
}

.empty-icon {
  margin-bottom: 20rpx;
  font-size: 70rpx;
}
