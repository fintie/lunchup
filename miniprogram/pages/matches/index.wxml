<view class="page">
  <view class="hero match-hero">
    <view class="hero-title">找到值得共进午餐的人</view>
    <view class="hero-copy">基于职业背景、技能、兴趣和常驻区域发现同行。</view>
  </view>

  <view class="search-box">
    <input class="search-input" value="{{query}}" bindinput="updateQuery" confirm-type="search" bindconfirm="search" placeholder="搜索姓名、公司或职位" />
    <button class="search-button" bindtap="search">搜索</button>
  </view>

  <view wx:if="{{loading}}" class="state">正在寻找合适的人...</view>
  <view wx:elif="{{error}}" class="state">{{error}}</view>

  <view wx:for="{{matches}}" wx:key="_id" class="card match-card">
    <view class="row">
      <image wx:if="{{item.profilePicture}}" class="avatar" src="{{item.profilePicture}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-fallback">{{item.avatarLetter}}</view>
      <view class="grow">
        <view class="row">
          <view class="card-title">{{item.name}}</view>
          <view class="score">{{item.matchScore}}%</view>
        </view>
        <view class="muted">{{item.professionalBackground || 'LunchUp 社区成员'}}</view>
        <view class="meta">{{item.preferredLocation || '澳大利亚'}}</view>
      </view>
    </view>
    <view class="tags">
      <view class="tag" wx:for="{{item.skills}}" wx:for-item="skill" wx:key="*this">{{skill}}</view>
    </view>
    <button class="button-primary" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="book">约一顿午餐</button>
  </view>
</view>
