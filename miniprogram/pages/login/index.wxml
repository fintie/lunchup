<view class="page auth-page">
  <view class="auth-mark">LU</view>
  <view class="auth-title">欢迎回来</view>
  <view class="muted auth-copy">登录后即可同步网页版账号、匹配和约饭记录。</view>

  <view class="form-card">
    <view class="field">
      <view class="field-label">邮箱</view>
      <input class="input" type="text" placeholder="you@example.com" data-field="email" bindinput="updateField" />
    </view>
    <view class="field">
      <view class="field-label">密码</view>
      <input class="input" password placeholder="请输入密码" data-field="password" bindinput="updateField" />
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="button-primary" loading="{{loading}}" bindtap="submit">登录</button>
    <button class="button-secondary" bindtap="openRegister">还没有账号？立即注册</button>
    <view class="demo">体验账号：demo@lunchup.com / password123</view>
  </view>
</view>
