<view class="page">
  <view class="section-title register-title">创建你的 LunchUp 资料</view>
  <view class="muted register-copy">越具体的职业背景和兴趣，匹配越有意思。</view>

  <view class="card form-card">
    <view class="field">
      <view class="field-label">姓名 *</view>
      <input class="input" data-field="name" bindinput="updateField" placeholder="你的姓名" />
    </view>
    <view class="field">
      <view class="field-label">邮箱 *</view>
      <input class="input" data-field="email" bindinput="updateField" placeholder="you@example.com" />
    </view>
    <view class="field">
      <view class="field-label">密码 *</view>
      <input class="input" password data-field="password" bindinput="updateField" placeholder="至少 6 位" />
    </view>
    <view class="field">
      <view class="field-label">职业背景</view>
      <input class="input" data-field="professionalBackground" bindinput="updateField" placeholder="例如：产品经理 / AI 创业者" />
    </view>
    <view class="field">
      <view class="field-label">技能</view>
      <input class="input" data-field="skills" bindinput="updateField" placeholder="产品, AI, 市场（逗号分隔）" />
    </view>
    <view class="field">
      <view class="field-label">午餐想聊的话题</view>
      <input class="input" data-field="preferredTopics" bindinput="updateField" placeholder="创业, 职业发展, 投资" />
    </view>
    <view class="field">
      <view class="field-label">常驻区域</view>
      <input class="input" data-field="preferredLocation" bindinput="updateField" placeholder="例如：Sydney CBD" />
    </view>
    <view class="field">
      <view class="field-label">偏好见面地点</view>
      <input class="input" data-field="preferredMeetingPoint" bindinput="updateField" placeholder="例如：Town Hall" />
    </view>
    <view class="field">
      <view class="field-label">感兴趣的活动</view>
      <textarea class="textarea" data-field="rawInterestText" bindinput="updateField" placeholder="例如：AI 创业早餐、投资人夜谈、科技活动" />
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="button-primary" loading="{{loading}}" bindtap="submit">创建账号</button>
  </view>
</view>
